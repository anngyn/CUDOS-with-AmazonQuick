{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGithubMLOpsLambdaLayerRead",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:*:919649535738:layer:python312-github-arm64:*"
    },
    {
      "Sid": "AllowGithubMLOpsLambdaUpdate",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:*:919649535738:function:sagemaker-*"
    }
  ]
}
